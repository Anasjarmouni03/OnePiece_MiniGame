# Added by Vercel's Neon integration. Use pooled connections for app traffic.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Added by the integration; direct connection preferred for build-time migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require

# Choose your own codes; the app has no default production PINs.
STAFF_PIN=replace-with-at-least-six-digits
TEAM_PINS=1:XXXX,2:XXXX,3:XXXX,4:XXXX,5:XXXX,6:XXXX,7:XXXX,8:XXXX

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters

# Optional canonical URL for QR codes. Normally the current site's origin is used.
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
